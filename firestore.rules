// ============================================================
//  Firestore Security Rules — 3DeT Utopia
//  Cole isso em: Firebase Console > Firestore > Rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Dados privados do usuário ──────────────────────────
    // Só o dono pode ler e escrever
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Fichas públicas ────────────────────────────────────
    // Qualquer pessoa pode LER se isPublic == true
    // Qualquer pessoa pode ESCREVER se isPublic == true E editPublic == true
    // O dono (_ownerUid) sempre pode escrever (para salvar alterações de visibilidade)
    match /public_fichas/{fichaId} {

      // Leitura: ficha marcada como pública
      allow read: if resource.data.isPublic == true;

      // Escrita pelo dono (atualizar a ficha, mudar visibilidade)
      allow write: if request.auth != null
                   && request.auth.uid == resource.data._ownerUid;

      // Criação pelo dono (primeira vez que torna pública)
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data._ownerUid;

      // Edição por terceiros (se editPublic == true)
      allow update: if resource.data.isPublic == true
                    && resource.data.editPublic == true;

      // Exclusão só pelo dono
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data._ownerUid;
    }
  }
}
